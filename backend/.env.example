# =============================================
# CONFIGURACIÓN DEL PROYECTO ATENEO
# =============================================
# Copia este archivo como .env y completa los valores

# --- Servidor ---
PORT=5000
NODE_ENV=development

# --- Base de Datos PostgreSQL ---
DATABASE_URL=postgresql://postgres:1234@localhost/ateneo
POSTGRES_URL=postgresql://postgres:1234@localhost/ateneo
PG_CONNECTION_STRING=postgresql://postgres:1234@localhost/ateneo
PG_SSL=false

# --- Autenticación JWT ---
JWT_SECRET=tu_clave_secreta_aqui_cambia_esta_en_produccion

# --- URLs ---
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
EXTRA_ORIGINS=

# --- Correo Electrónico (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_email@gmail.com
SMTP_PASS=tu_password_de_app
SMTP_FROM=Ateneo <tu_email@gmail.com>

# --- SendGrid (alternativo a SMTP) ---
# SENDGRID_API_KEY=tu_api_key_de_sendgrid

# --- Mercado Pago (Pagos) ---
# MP_ACCESS_TOKEN=tu_access_token_de_mercadopago

# --- Códigos de Invitación ---
TEACHER_INVITE_CODE=Profesores010
ADMIN_INVITE_CODE=Admin2024
ADMIN_SELF_REGISTRATION=false
