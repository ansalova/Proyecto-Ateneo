# Backend - ejemplo de .env

# Server
PORT=5000
NODE_ENV=development

# Database - PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/ateneo
# Alternative formats (pick one based on your DB provider):
# POSTGRES_URL=postgresql://...
# PG_CONNECTION_STRING=postgresql://...
PG_SSL=false

# CORS
FRONTEND_URL=http://localhost:5173
# Para múltiples orígenes (separados por coma):
EXTRA_ORIGINS=http://localhost:3000,http://localhost:8000

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_me_in_production

# Mercado Pago (opcional - si no se configura, MP estará deshabilitado)
MP_ACCESS_TOKEN=
BACKEND_URL=http://localhost:5000

# Números para métodos offline
NEQUI_NUMBER=3105757686
DAVIPLATA_NUMBER=3105757686

# Códigos de invitación
TEACHER_INVITE_CODE=Profesores2026   # ejemplo, cambia a "Profesores010" o lo que uses en desarrollo
ADMIN_INVITE_CODE=ADMIN123
ADMIN_SELF_REGISTRATION=false

# SMTP (opcional) - si no se configura, se usa Ethereal para pruebas
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Ateneo <no-reply@ateneo.local>"

